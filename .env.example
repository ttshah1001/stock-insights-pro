# Polygon.io (Massive) API key for real-time market data
POLYGON_API_KEY=your_polygon_key
# Alpha Vantage for more historical data and quotes
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
# Optional: RapidAPI "Yahoo Finance" API key for real-time quotes (get at rapidapi.com)
# Use as RAPIDAPI_KEY or YAHOO_FINANCE_API_KEY
RAPIDAPI_KEY=your_rapidapi_key
# Marketstack API key (EOD + intraday)
MARKETSTACK_API_KEY=your_marketstack_key
